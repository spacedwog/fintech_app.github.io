# Agente de orçamento - nunca versionar segredos nem dados financeiros pessoais.
# Este repositório é público (GitHub Pages) - um token do Mercado Pago aqui
# exposto dá acesso à conta real do usuário.
orcamento_agent/config.json
orcamento_agent/layout.json
orcamento_agent/logs/
orcamento_agent/__pycache__/
orcamento_agent/.~lock.*
orcamento_agent/TEST_*.xlsx
orcamento_agent/TEST_*.json

# Agentes de reconciliação/geração de despesas Mercado Pago x painel web
# (mp_reconcile.py, mp_expenses.py) - mesmo cuidado: o config real tem o
# Access Token do Mercado Pago, e uma eventual chave de conta de serviço do
# Firebase dá acesso de leitura/escrita total ao banco (Firestore) do app.
# Nenhum desses configs pode ir para o repositório público.
orcamento_agent/mp_reconcile_config.json
orcamento_agent/mp_expenses_config.json
orcamento_agent/mp_open_finance_config.json
orcamento_agent/mp_oauth_account_config.json
orcamento_agent/open_finance_dlq.jsonl
orcamento_agent/*serviceAccount*.json
# Exportações de atividades reais do Mercado Pago (mp_list_activities.py
# --export) -- são dados financeiros reais (valores, descrições, e-mail de
# pagadores), nunca versionar. Cubra qualquer nome usado com --export
# começando com um destes prefixos.
orcamento_agent/mp_activities*.csv
orcamento_agent/mp_activities*.json
orcamento_agent/atividades*.csv
orcamento_agent/atividades*.json
orcamento_agent/*service-account*.json
orcamento_agent/firebase-adminsdk*.json

# Agente de emissão de nota fiscal (nfse_issuer.py) - o config real tem o
# token da Focus NFe (emite notas fiscais reais em nome da empresa, com
# custo). Nunca versionar.
orcamento_agent/nfse_config.json

# Agente Fibonacci + Laplace (ETL) - mesmos cuidados de teste/cache.
fibonacci_laplace_agent/__pycache__/
fibonacci_laplace_agent/TEST_*.xlsx
fibonacci_laplace_agent/TEST_*.json
fibonacci_laplace_agent/resultado_pipeline.json
